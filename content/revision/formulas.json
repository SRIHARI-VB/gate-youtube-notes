[
  {
    "group": "Foundations",
    "items": [
      {
        "name": "Product rule",
        "latex": "|A_1| \\times |A_2| \\times \\cdots \\times |A_k|",
        "note": "independent stages"
      },
      {
        "name": "Sum rule",
        "latex": "|A| + |B|",
        "note": "disjoint cases only"
      },
      {
        "name": "Subtraction",
        "latex": "|A \\setminus B| = |A| - |A \\cap B|",
        "note": ""
      }
    ]
  },
  {
    "group": "Arrangements and selections",
    "items": [
      {
        "name": "Factorial",
        "latex": "n!",
        "note": "arrangements of n distinct objects"
      },
      {
        "name": "Permutation",
        "latex": "P(n,r) = \\dfrac{n!}{(n-r)!}",
        "note": "ordered selection"
      },
      {
        "name": "Combination",
        "latex": "C(n,r) = \\dfrac{n!}{r!(n-r)!}",
        "note": "unordered selection"
      },
      {
        "name": "Circular",
        "latex": "(n-1)!",
        "note": "rotations identified"
      },
      {
        "name": "Multiset",
        "latex": "\\dfrac{n!}{n_1! n_2! \\cdots n_k!}",
        "note": "repeated symbols"
      },
      {
        "name": "Strings",
        "latex": "n^k",
        "note": "length k over n symbols, reuse allowed"
      }
    ]
  },
  {
    "group": "Balls and boxes",
    "items": [
      {
        "name": "DODB",
        "latex": "k^n",
        "note": "empty boxes allowed"
      },
      {
        "name": "DODB onto",
        "latex": "k!\\,S(n,k)",
        "note": "no empty box"
      },
      {
        "name": "IODB",
        "latex": "C(n+k-1,\\,k-1)",
        "note": "empty allowed"
      },
      {
        "name": "IODB positive",
        "latex": "C(n-1,\\,k-1)",
        "note": "each box at least one"
      },
      {
        "name": "IODB lower bound r",
        "latex": "C(n-kr+k-1,\\,k-1)",
        "note": "each box at least r"
      },
      {
        "name": "DOIB",
        "latex": "S(n,k)",
        "note": "Stirling second kind"
      },
      {
        "name": "Stirling recurrence",
        "latex": "S(n,k) = k\\,S(n-1,k) + S(n-1,k-1)",
        "note": ""
      },
      {
        "name": "IOIB",
        "latex": "p(n)",
        "note": "partitions into at most k parts, enumerate"
      }
    ]
  },
  {
    "group": "Constraints",
    "items": [
      {
        "name": "Two sets",
        "latex": "|A \\cup B| = |A| + |B| - |A \\cap B|",
        "note": ""
      },
      {
        "name": "Three sets",
        "latex": "\\sum |A_i| - \\sum |A_i \\cap A_j| + |A_1 \\cap A_2 \\cap A_3|",
        "note": "alternating"
      },
      {
        "name": "Derangement",
        "latex": "!n = n!\\sum_{k=0}^{n} \\dfrac{(-1)^k}{k!}",
        "note": "nearest integer to n!/e"
      },
      {
        "name": "Derangement recurrence",
        "latex": "!n = (n-1)(!(n-1) + !(n-2))",
        "note": "!1=0, !2=1"
      },
      {
        "name": "Onto functions",
        "latex": "\\sum_{k=0}^{n} (-1)^k C(n,k)(n-k)^m = n!\\,S(m,n)",
        "note": "m-set onto n-set"
      },
      {
        "name": "Pigeonhole",
        "latex": "k(r-1)+1",
        "note": "objects to force r in some box"
      },
      {
        "name": "Binomial",
        "latex": "(x+y)^n = \\sum_{k=0}^{n} C(n,k)x^{n-k}y^k",
        "note": ""
      },
      {
        "name": "Negative binomial",
        "latex": "[x^r]\\,(1-x)^{-n} = C(n+r-1,\\,r)",
        "note": "coefficient extraction"
      }
    ]
  },
  {
    "group": "Propositional connectives",
    "items": [
      {
        "name": "Implication",
        "latex": "p \\to q \\;\\equiv\\; \\lnot p \\lor q",
        "note": "false only at p=T, q=F"
      },
      {
        "name": "Contrapositive",
        "latex": "p \\to q \\;\\equiv\\; \\lnot q \\to \\lnot p",
        "note": "the only equivalent rewrite of the three"
      },
      {
        "name": "Converse / inverse",
        "latex": "q \\to p, \\quad \\lnot p \\to \\lnot q",
        "note": "equivalent to each other, not to p -> q"
      },
      {
        "name": "Biconditional",
        "latex": "p \\leftrightarrow q \\;\\equiv\\; (p \\to q) \\land (q \\to p)",
        "note": "true when p and q agree"
      },
      {
        "name": "Negation of implication",
        "latex": "\\lnot (p \\to q) \\;\\equiv\\; p \\land \\lnot q",
        "note": "the one falsifying row"
      },
      {
        "name": "English map",
        "latex": "p \\text{ only if } q \\equiv p \\to q, \\quad p \\text{ unless } q \\equiv \\lnot q \\to p",
        "note": "'if' points the other way"
      }
    ]
  },
  {
    "group": "Equivalence laws",
    "items": [
      {
        "name": "De Morgan",
        "latex": "\\lnot (p \\land q) \\equiv \\lnot p \\lor \\lnot q",
        "note": "flip the connective too"
      },
      {
        "name": "Distributive",
        "latex": "p \\land (q \\lor r) \\equiv (p \\land q) \\lor (p \\land r)",
        "note": ""
      },
      {
        "name": "Absorption",
        "latex": "p \\lor (p \\land q) \\equiv p",
        "note": ""
      },
      {
        "name": "Exportation",
        "latex": "(p \\land q) \\to r \\equiv p \\to (q \\to r)",
        "note": "implication is not associative"
      },
      {
        "name": "Negation laws",
        "latex": "p \\lor \\lnot p \\equiv T, \\quad p \\land \\lnot p \\equiv F",
        "note": ""
      }
    ]
  },
  {
    "group": "Normal forms",
    "items": [
      {
        "name": "PDNF",
        "latex": "\\bigvee_{F=1} m_j",
        "note": "one minterm per true row"
      },
      {
        "name": "PCNF",
        "latex": "\\bigwedge_{F=0} M_j",
        "note": "one maxterm per false row"
      },
      {
        "name": "Maxterm vs minterm",
        "latex": "M_j \\equiv \\lnot m_j",
        "note": "same index, flipped literals"
      },
      {
        "name": "Counts",
        "latex": "2^n \\text{ minterms}, \\; 2^n \\text{ maxterms}, \\; 2^{2^n} \\text{ functions}",
        "note": "n = number of variables"
      }
    ]
  },
  {
    "group": "Semantics",
    "items": [
      {
        "name": "Interpretations",
        "latex": "2^n",
        "note": "rows of the truth table"
      },
      {
        "name": "Entailment",
        "latex": "F_1, \\dots, F_n \\models G",
        "note": "every model of the premises is a model of G"
      },
      {
        "name": "Deduction theorem",
        "latex": "F_1 \\land \\cdots \\land F_n \\models G \\iff (F_1 \\land \\cdots \\land F_n) \\to G \\text{ valid}",
        "note": ""
      },
      {
        "name": "Refutation form",
        "latex": "F_1 \\land \\cdots \\land F_n \\land \\lnot G \\text{ unsatisfiable}",
        "note": ""
      },
      {
        "name": "Validity vs satisfiability",
        "latex": "F \\text{ valid} \\iff \\lnot F \\text{ unsatisfiable}",
        "note": "not valid is not the same as contradiction"
      }
    ]
  },
  {
    "group": "Inference and resolution",
    "items": [
      {
        "name": "Modus ponens",
        "latex": "p, \\; p \\to q \\;\\vdash\\; q",
        "note": ""
      },
      {
        "name": "Modus tollens",
        "latex": "\\lnot q, \\; p \\to q \\;\\vdash\\; \\lnot p",
        "note": ""
      },
      {
        "name": "Hypothetical syllogism",
        "latex": "p \\to q, \\; q \\to r \\;\\vdash\\; p \\to r",
        "note": ""
      },
      {
        "name": "Disjunctive syllogism",
        "latex": "p \\lor q, \\; \\lnot p \\;\\vdash\\; q",
        "note": ""
      },
      {
        "name": "Resolution",
        "latex": "(p \\lor r), \\; (q \\lor \\lnot r) \\;\\vdash\\; (p \\lor q)",
        "note": "one direction only"
      },
      {
        "name": "Refutation",
        "latex": "KB \\models \\alpha \\iff KB \\land \\lnot \\alpha \\vdash \\square",
        "note": "empty clause = contradiction"
      }
    ]
  },
  {
    "group": "Complete connective sets",
    "items": [
      {
        "name": "NAND",
        "latex": "p \\uparrow q \\equiv \\lnot (p \\land q)",
        "note": "{NAND} is functionally complete"
      },
      {
        "name": "NOR",
        "latex": "p \\downarrow q \\equiv \\lnot (p \\lor q)",
        "note": "{NOR} is functionally complete"
      },
      {
        "name": "Negation from NAND",
        "latex": "\\lnot p \\equiv p \\uparrow p",
        "note": ""
      },
      {
        "name": "Negation from NOR",
        "latex": "\\lnot p \\equiv p \\downarrow p",
        "note": ""
      },
      {
        "name": "Not complete",
        "latex": "\\{\\land, \\lor\\}, \\; \\{\\oplus, \\land\\}",
        "note": "monotone / 0-preserving, so no negation"
      }
    ]
  },
  {
    "group": "Quantifiers",
    "items": [
      {
        "name": "Quantifier negation",
        "latex": "\\lnot \\forall x P(x) \\equiv \\exists x \\lnot P(x)",
        "note": "and the dual"
      },
      {
        "name": "Restricted universal",
        "latex": "\\forall x (S(x) \\to P(x))",
        "note": "implication, not conjunction"
      },
      {
        "name": "Restricted existential",
        "latex": "\\exists x (S(x) \\land P(x))",
        "note": "conjunction, not implication"
      },
      {
        "name": "Order matters",
        "latex": "\\forall x \\exists y R(x,y) \\not\\equiv \\exists y \\forall x R(x,y)",
        "note": "the second is stronger"
      }
    ]
  },
  {
    "group": "First order logic",
    "items": [
      {
        "name": "Quantifier negation",
        "latex": "\\neg \\forall x\\, P(x) \\equiv \\exists x\\, \\neg P(x)",
        "note": "and dually for the existential"
      },
      {
        "name": "Universal instantiation",
        "latex": "\\forall x\\, P(x) \\vdash P(c)",
        "note": "c in the domain"
      },
      {
        "name": "Null quantification",
        "latex": "\\forall x (P(x) \\lor W) \\equiv \\forall x P(x) \\lor W",
        "note": "W has no free x"
      },
      {
        "name": "Arrow case",
        "latex": "\\exists x (P(x) \\to W) \\equiv \\forall x P(x) \\to W",
        "note": "the universal form is not valid"
      },
      {
        "name": "Distribution",
        "latex": "\\forall x (P \\land Q) \\equiv \\forall x P \\land \\forall x Q",
        "note": "and dually exists over or"
      },
      {
        "name": "Quantifier order",
        "latex": "\\exists y \\forall x R(x,y) \\Rightarrow \\forall x \\exists y R(x,y)",
        "note": "never the converse"
      },
      {
        "name": "Exactly one",
        "latex": "\\exists x (P(x) \\land \\forall y (P(y) \\to y = x))",
        "note": "uniqueness needs equality"
      },
      {
        "name": "Model size",
        "latex": "\\exists^{k} \\forall^{m} \\psi \\text{ has a model of size} \\le k",
        "note": "no function symbols"
      }
    ]
  },
  {
    "group": "Partial orders and lattices",
    "items": [
      {
        "name": "Partial order",
        "latex": "\\text{reflexive} \\wedge \\text{antisymmetric} \\wedge \\text{transitive}",
        "note": "then (A, R) is a poset"
      },
      {
        "name": "Join",
        "latex": "a \\vee b = \\mathrm{lub}(a, b)",
        "note": "must lie in the poset"
      },
      {
        "name": "Meet",
        "latex": "a \\wedge b = \\mathrm{glb}(a, b)",
        "note": "must lie in the poset"
      },
      {
        "name": "Lattice",
        "latex": "\\forall a, b:\\ a \\vee b \\text{ and } a \\wedge b \\text{ exist}",
        "note": "pairwise test, not subsetwise"
      },
      {
        "name": "Absorption",
        "latex": "a \\vee (a \\wedge b) = a, \\quad a \\wedge (a \\vee b) = a",
        "note": "holds in every lattice"
      },
      {
        "name": "Distributive",
        "latex": "a \\wedge (b \\vee c) = (a \\wedge b) \\vee (a \\wedge c)",
        "note": "fails in M3 and N5 only"
      },
      {
        "name": "Complement",
        "latex": "a \\wedge a' = 0, \\quad a \\vee a' = 1",
        "note": "unique in a distributive lattice"
      },
      {
        "name": "Boolean lattice",
        "latex": "|B_n| = 2^n, \\quad \\text{covering pairs} = n \\, 2^{n-1}",
        "note": "bounded + complemented + distributive"
      },
      {
        "name": "Divisor lattice",
        "latex": "a \\vee b = \\mathrm{lcm}(a,b),\\ a \\wedge b = \\gcd(a,b)",
        "note": "Boolean iff n is squarefree"
      },
      {
        "name": "Mirsky",
        "latex": "\\text{longest chain} = n \\Rightarrow n \\text{ antichains}",
        "note": "Dilworth is the dual statement"
      }
    ]
  },
  {
    "group": "Monoids and groups",
    "items": [
      {
        "name": "Group axioms",
        "latex": "a(bc)=(ab)c,\\quad ae=ea=a,\\quad aa^{-1}=a^{-1}a=e",
        "note": "closure, associativity, identity, inverses"
      },
      {
        "name": "Reversal rule",
        "latex": "(ab)^{-1}=b^{-1}a^{-1}",
        "note": "order reverses; collapses only when abelian"
      },
      {
        "name": "Order of an element",
        "latex": "|a|=n \\iff a^{n}=e \\text{ and } a^{k}\\ne e \\ (0<k<n)",
        "note": "equals the order of <a>"
      },
      {
        "name": "Order divides order",
        "latex": "|a| \\mid |G|",
        "note": "corollary of Lagrange"
      },
      {
        "name": "Commutativity test 1",
        "latex": "(ab)^2=a^2b^2\\ \\forall a,b \\iff G \\text{ abelian}",
        "note": "cancel a on the left, b on the right"
      },
      {
        "name": "Commutativity test 2",
        "latex": "a^2=e\\ \\forall a \\iff G \\text{ abelian}",
        "note": "every element self-inverse"
      },
      {
        "name": "Lagrange",
        "latex": "|G|=[G:H]\\,|H|",
        "note": "index times subgroup order"
      },
      {
        "name": "Largest proper subgroup",
        "latex": "\\max |H|=\\frac{|G|}{p_{\\min}}",
        "note": "p_min = smallest prime factor of |G|"
      },
      {
        "name": "Generators of Z_n",
        "latex": "\\#\\{a: \\langle a\\rangle=Z_n\\}=\\varphi(n)",
        "note": "residues coprime to n"
      },
      {
        "name": "Prime order",
        "latex": "|G|=p \\Rightarrow G \\text{ cyclic, hence abelian}",
        "note": "p prime"
      },
      {
        "name": "Self-inverse in Z_2 x Z_3 x Z_4",
        "latex": "\\gcd(2,2)\\cdot\\gcd(2,3)\\cdot\\gcd(2,4)=4",
        "note": "solve 2x=0 componentwise"
      },
      {
        "name": "Element order in a direct product",
        "latex": "|(a,b)|=\\operatorname{lcm}(|a|,|b|)",
        "note": "decides cyclicity of G x H"
      }
    ]
  }
]
