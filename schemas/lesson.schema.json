{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual lesson",
  "type": "object",
  "required": [
    "slug",
    "topic",
    "engine"
  ],
  "properties": {
    "slug": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "engine": {
      "enum": [
        "p5.js",
        "html"
      ]
    },
    "steps": {
      "type": "integer",
      "minimum": 1
    },
    "example": {
      "type": "object"
    },
    "cells": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "engine": {
            "const": "p5.js"
          }
        }
      },
      "then": {
        "required": [
          "steps"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "engine": {
            "const": "html"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "steps"
            ]
          },
          {
            "required": [
              "cells"
            ]
          }
        ]
      }
    }
  ]
}
